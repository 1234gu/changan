# Frontend node data source: real | mock | mixed
# real is the default and never falls back to simulator data when FastAPI is unavailable.
VITE_NODE_DATA_MODE=real

# Leave empty during Vite development to use the /api proxy configured in vite.config.ts.
# For a separately hosted frontend, set the FastAPI origin, for example:
# VITE_API_BASE_URL=http://192.168.1.20:8000
VITE_API_BASE_URL=

# Reserved for the external Scheduler adapter. Submission remains disabled
# until the Scheduler request/response contract is frozen by both sides.
VITE_SCHEDULER_BASE_URL=
